{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aihot-trigger",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-26",
  "triggers": {
    // 日报项目已于 2026-08-19 暂停；保留 Worker 代码，但不再定时触发。
