{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aihot-trigger",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-26",
  "triggers": {
    "crons": ["30 21 * * *", "48 21 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["GH_PAT"]
  }
}
